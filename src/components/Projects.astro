---
import { projects, site } from '../data/site';

const github = site.socials.find((s) => s.label === 'GitHub')?.href;
// Each project gets a distinct gradient "cover", no image downloads needed.
const hues = [228, 170, 280, 20, 200, 330];
---

<section class="section" id="projects">
  <div class="container">
    <div class="section-head head" data-reveal>
      <div>
        <p class="eyebrow">03 · Projects</p>
        <h2 class="section-title">Selected <span class="hl">work</span></h2>
      </div>
      {github && <a href={github} class="btn" target="_blank" rel="noopener noreferrer">More on GitHub ↗</a>}
    </div>

    <div class="grid">
      {
        projects.map((p, i) => (
          <article class:list={['card', 'project', { featured: p.featured }]} data-reveal style={`--delay: ${(i % 2) * 90}ms; --h: ${hues[i % hues.length]}`}>
            <div class="cover" aria-hidden="true">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <div class="mock">
                <div class="mock-bar"><i /><i /><i /><b /></div>
                <div class="mock-body">
                  <div class="mock-copy">
                    <span /><span /><span />
                    <em />
                  </div>
                  <div class="mock-img" />
                </div>
              </div>
            </div>
            <div class="content">
              <h3>{p.title}</h3>
              <p class="muted">{p.description}</p>
              <ul class="tags">
                {p.tags.map((t) => <li class="chip">{t}</li>)}
              </ul>
              <div class="links">
                {p.live && (
                  <a href={p.live} target="_blank" rel="noopener noreferrer">
                    Live site <span class="sr-only">for {p.title}</span> ↗
                  </a>
                )}
                {p.code && (
                  <a href={p.code} target="_blank" rel="noopener noreferrer">
                    Source code <span class="sr-only">for {p.title}</span> ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .cover {
    position: relative;
    aspect-ratio: 16 / 8;
    background:
      radial-gradient(circle at 20% 20%, hsl(var(--h) 90% 70% / 0.55), transparent 55%),
      radial-gradient(circle at 85% 80%, hsl(calc(var(--h) + 50) 85% 60% / 0.45), transparent 55%),
      var(--bg-soft);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .num {
    position: absolute;
    top: 1rem;
    left: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .mock {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -10%;
    height: 76%;
    border-radius: 12px 12px 0 0;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.5s var(--ease);
  }
  .project:hover .mock {
    transform: translateY(-10px) scale(1.02);
  }
  .mock-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .mock-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border);
  }
  .mock-bar b {
    flex: 1;
    height: 0.6rem;
    margin-left: 0.6rem;
    max-width: 50%;
    border-radius: 99px;
    background: var(--bg);
  }
  .mock-body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1rem;
    padding: 1rem;
    height: 100%;
  }
  .mock-copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .mock-copy span {
    height: 0.55rem;
    border-radius: 99px;
    background: var(--border);
  }
  .mock-copy span:nth-child(1) {
    height: 0.85rem;
    width: 90%;
    background: hsl(var(--h) 80% 70% / 0.85);
  }
  .mock-copy span:nth-child(2) {
    width: 100%;
  }
  .mock-copy span:nth-child(3) {
    width: 70%;
  }
  .mock-copy em {
    width: 45%;
    height: 1.3rem;
    margin-top: 0.35rem;
    border-radius: 99px;
    background: linear-gradient(90deg, hsl(var(--h) 85% 62%), hsl(calc(var(--h) + 50) 85% 60%));
  }
  .mock-img {
    height: 70%;
    border-radius: 10px;
    background:
      radial-gradient(circle at 30% 30%, hsl(var(--h) 90% 75% / 0.7), transparent 60%),
      linear-gradient(135deg, hsl(var(--h) 70% 50% / 0.5), hsl(calc(var(--h) + 50) 70% 50% / 0.5));
  }
  .content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }
  h3 {
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .content > p {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .links a {
    color: var(--accent);
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--accent-2);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
