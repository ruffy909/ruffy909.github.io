---
import { site, stats } from '../data/site';

const firstName = site.name.split(' ')[0];
---

<section class="hero" id="top">
  <div class="bg" aria-hidden="true">
    <div class="grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
  </div>

  <div class="container inner">
    <div class="copy">
      {
        site.available && (
          <p class="badge" data-reveal>
            <span class="pulse" aria-hidden="true" />
            Available for freelance &amp; full-time work
          </p>
        )
      }
      <h1 data-reveal style="--delay: 80ms">
        Hi, I'm {firstName}.<br />
        <span class="gradient">{site.headline}</span>
      </h1>
      <p class="lead muted" data-reveal style="--delay: 160ms">{site.intro}</p>

      <div class="cta" data-reveal style="--delay: 240ms">
        <a href="#projects" class="btn btn-primary">
          View my work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#contact" class="btn">Let's talk</a>
        {site.resume && <a href={site.resume} class="btn" download>Download CV</a>}
      </div>

      <dl class="stats" data-reveal style="--delay: 320ms">
        {
          stats.map((s) => (
            <div>
              <dt class="muted">{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="visual" data-reveal style="--delay: 200ms" aria-hidden="true">
      <div class="window">
        <div class="titlebar">
          <span></span><span></span><span></span>
          <p>developer.ts</p>
        </div>
        <pre><code><span class="k">const</span> <span class="v">developer</span> = {'{'}
  name: <span class="s">'{site.name}'</span>,
  role: <span class="s">'{site.role}'</span>,
  location: <span class="s">'{site.location}'</span>,
  stack: [<span class="s">'Astro'</span>, <span class="s">'React'</span>, <span class="s">'TypeScript'</span>],
  focus: <span class="s">'performance &amp; UX'</span>,
  coffee: <span class="n">Infinity</span>,
{'}'};

<span class="k">export default</span> <span class="v">developer</span>;<span class="caret"></span></code></pre>
      </div>
      <div class="float-card">
        <span class="score">100</span>
        <span>Lighthouse<br /><small class="muted">Performance</small></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4rem, 9vw, 6.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .bg {
    position: absolute;
    inset: -4.25rem 0 0;
    z-index: -1;
    pointer-events: none;
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.45;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
  }
  .orb-1 {
    width: 420px;
    height: 420px;
    top: -80px;
    left: -120px;
    background: var(--accent);
  }
  .orb-2 {
    width: 360px;
    height: 360px;
    top: 120px;
    right: -100px;
    background: var(--accent-2);
    opacity: 0.22;
  }

  .inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  h1 {
    font-size: clamp(2.3rem, 5.6vw, 4rem);
    line-height: 1.07;
    letter-spacing: -0.045em;
    font-weight: 800;
  }
  .gradient {
    background: linear-gradient(100deg, var(--text) 10%, var(--accent) 55%, var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: 1.125rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .stats {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-size: 0.85rem;
  }
  .stats dd {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .visual {
    position: relative;
  }
  .window {
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow), 0 0 0 6px var(--glow);
    overflow: hidden;
    transform: perspective(1200px) rotateY(-6deg) rotateX(3deg);
    transition: transform 0.6s var(--ease);
  }
  .visual:hover .window {
    transform: none;
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .titlebar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .titlebar span:nth-child(2) {
    background: #febc2e;
  }
  .titlebar span:nth-child(3) {
    background: #28c840;
  }
  .titlebar p {
    margin-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  pre {
    padding: 1.25rem 1.35rem 1.5rem;
    font-family: var(--font-mono);
    font-size: clamp(0.74rem, 1.2vw, 0.86rem);
    line-height: 1.8;
    overflow-x: auto;
    color: var(--muted);
  }
  .k {
    color: #c084fc;
  }
  .v {
    color: var(--accent);
  }
  .s {
    color: var(--accent-2);
  }
  .n {
    color: #fb923c;
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .float-card {
    position: absolute;
    left: -1.5rem;
    bottom: -1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.1rem 0.75rem 0.75rem;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    animation: float 6s ease-in-out infinite;
  }
  .score {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 3px solid #22c55e;
    color: #22c55e;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: 1fr;
    }
    .visual {
      max-width: 34rem;
      margin-top: 1rem;
    }
    .float-card {
      left: auto;
      right: 1rem;
    }
  }
  @media (max-width: 480px) {
    .stats dd {
      font-size: 1.5rem;
    }
  }
</style>
