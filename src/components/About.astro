---
import { about, site } from '../data/site';

const highlights = [
  { title: 'Performance first', text: 'Lean pages, optimized assets and green Core Web Vitals.' },
  { title: 'Pixel-perfect UI', text: 'Faithful, responsive builds from Figma to production.' },
  { title: 'Accessible by default', text: 'Semantic HTML, keyboard support and readable contrast.' },
  { title: 'SEO ready', text: 'Structured data, clean markup and fast load times.' },
];
---

<section class="section about" id="about">
  <div class="bg" aria-hidden="true">
    <div class="dots"></div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>
  <div class="container inner">
    <div class="section-head" data-reveal>
      <p class="eyebrow">01 · About me</p>
      <h2 class="section-title">Code with craft,<br />design with purpose.</h2>
    </div>

    <div class="body">
      <div class="text" data-reveal>
        {about.map((p) => <p class="muted">{p}</p>)}
        <p class="meta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          Based in {site.location} · Working with clients worldwide
        </p>
      </div>

      <ul class="highlights">
        {
          highlights.map((h, i) => (
            <li class="card" data-reveal style={`--delay: ${i * 70}ms`}>
              <h3>{h.title}</h3>
              <p class="muted">{h.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, var(--bg) 0%, color-mix(in srgb, var(--accent) 6%, var(--bg)) 50%, var(--bg) 100%);
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 60% 70% at 20% 30%, #000 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 20% 30%, #000 20%, transparent 70%);
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }
  .glow-1 {
    width: 380px;
    height: 380px;
    top: 10%;
    right: -80px;
    background: var(--accent);
    opacity: 0.16;
  }
  .glow-2 {
    width: 300px;
    height: 300px;
    bottom: -60px;
    left: 25%;
    background: var(--accent-2);
    opacity: 0.12;
  }
  .highlights li {
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .text p + p {
    margin-top: 1.1rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.93rem;
    color: var(--text);
  }
  .meta svg {
    color: var(--accent-2);
    flex-shrink: 0;
  }
  .highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .highlights li {
    padding: 1.35rem;
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }
  .highlights p {
    font-size: 0.92rem;
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
