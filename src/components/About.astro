---
import { about, site } from '../data/site';

const highlights = [
  { title: 'Performance first', text: 'Lean pages, optimized assets and green Core Web Vitals.', icon: 'M13 2 3 14h9l-1 8 10-12h-9z', hue: 228 },
  { title: 'Pixel-perfect UI', text: 'Faithful, responsive builds from Figma to production.', icon: 'M12 19l7-7 3 3-7 7zM18 13l-1.5-7.5L2 2l3.5 14.5L13 18zM2 2l7.6 7.6M11 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4z', hue: 280 },
  { title: 'Accessible by default', text: 'Semantic HTML, keyboard support and readable contrast.', icon: 'M12 5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM4 8l8 2 8-2M12 10v5l-3 7M12 15l3 7', hue: 170 },
  { title: 'SEO ready', text: 'Structured data, clean markup and fast load times.', icon: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3', hue: 30 },
];
---

<section class="section about" id="about">
  <div class="container inner">
    <div class="section-head" data-reveal>
      <p class="eyebrow">01 · About me</p>
      <h2 class="section-title">Code with craft,<br />design with <span class="hl">purpose.</span></h2>
    </div>

    <div class="body">
      <div class="text" data-reveal>
        {about.map((p) => <p class="muted">{p}</p>)}
        <p class="meta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          Based in {site.location} · Working with clients worldwide
        </p>
      </div>

      <ul class="highlights">
        {
          highlights.map((h, i) => (
            <li class="card" data-reveal style={`--delay: ${i * 70}ms; --h: ${h.hue}`}>
              <span class="icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={h.icon} /></svg>
              </span>
              <h3>{h.title}</h3>
              <p class="muted">{h.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }
  .highlights li {
    background: var(--bg-soft);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border-radius: 12px;
    color: hsl(var(--h) 90% 72%);
    background: hsl(var(--h) 90% 65% / 0.12);
    border: 1px solid hsl(var(--h) 90% 65% / 0.3);
  }
  :global([data-theme='light']) .icon {
    color: hsl(var(--h) 70% 42%);
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .text p + p {
    margin-top: 1.1rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.93rem;
    color: var(--text);
  }
  .meta svg {
    color: var(--accent-2);
    flex-shrink: 0;
  }
  .highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .highlights li {
    padding: 1.35rem;
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }
  .highlights p {
    font-size: 0.92rem;
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
