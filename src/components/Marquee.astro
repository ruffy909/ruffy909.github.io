---
import { skills } from '../data/site';

const items = skills.flatMap((g) => g.items);
---

<div class="marquee" aria-label="Tools I work with">
  <div class="track">
    {
      [0, 1].map((copy) => (
        <ul aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li>
              <span class="star" aria-hidden="true">✦</span>
              {item}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    padding-block: 1.1rem;
    border-block: 1px solid var(--border);
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 10%, var(--bg-soft)), color-mix(in srgb, var(--accent-2) 10%, var(--bg-soft)));
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  ul {
    display: flex;
    flex-shrink: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-right: 1.25rem;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .star {
    color: var(--accent-2);
    font-size: 0.8em;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
